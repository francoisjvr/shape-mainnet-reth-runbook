# Copy to .env and replace placeholder values.

# Required L1 endpoints
L1_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME
L1_BEACON_URL=https://eth-mainnet-beacon.example.invalid/REPLACE_ME

# Pinned runtime images
OP_RETH_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-reth:v2.2.2
OP_NODE_IMAGE=us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:v1.18.0

# Canonical directories
RETH_DATA_DIR=/root/shape-mainnet-op-reth-data
RETH_STAGING_DIR=/root/shape-mainnet-op-reth-staging
OP_NODE_DATA_DIR=/root/shape-mainnet-op-node-data
RETH_CONFIG_DIR=/root/.shape-mainnet-op-reth
JWT_SECRET_PATH=/root/.shape-mainnet-op-reth/jwt.hex

# Runtime config files
RETH_CONFIG_FILE=/root/.shape-mainnet-op-reth/reth.runtime.toml
GENESIS_L2_FILE=/root/.shape-mainnet-op-reth/genesis-l2.runtime.json
ROLLUP_CONFIG_FILE=/root/.shape-mainnet-op-reth/rollup.runtime.json

# Isolated ports
RETH_HTTP_PORT=18545
RETH_WS_PORT=18546
RETH_AUTH_PORT=18551
RETH_P2P_PORT=31303
OP_NODE_RPC_PORT=19545
OP_NODE_P2P_PORT=19222
OP_NODE_METRICS_PORT=17300

# Shape L2 RPCs
SHAPE_SEQUENCER_URL=https://mainnet.shape.network
SHAPE_HISTORICAL_RPC_URL=https://mainnet.shape.network

# Shape bootnodes: replace with validated current values.
OP_NODE_BOOTNODES=REPLACE_WITH_VALIDATED_BOOTNODES
